var ENV = process.env,
    task = JAKE.task,
    cp = require("child_process"),
    fs = require("fs"),
    path = require("path");

/*
 * The frameworks configure copies into each manual test application.  The
 * comment on configure explains why they are copies.
 */
var ConfiguredFrameworks = ["Objective-J", "Foundation", "AppKit", "BlendKit"];

/*
 * Standard build targets are neutered at this directory level to prevent automated
 * CI runners from triggering exhaustive, recursive compilations across all manual test suites.
 */
task ("default", function()
{
    console.log("Global traversal disabled to prevent CI timeouts.");
    console.log("Use 'npx jake batch-compile' or 'npx jake batch-compile-all' to deliberately build the suite.");
});

task ("build", ["default"]);
task ("build-all", ["default"]);
task ("debug", ["default"]);
task ("release", ["default"]);

/*
 * -----------------------------------------------------------------------------
 * Environment Management
 * -----------------------------------------------------------------------------
 */

/*
 * Gives manual test applications the frameworks built in this repository, so
 * that an application runs without being built itself: index.html loads the
 * release frameworks and index-debug.html the debug frameworks.  The layout is
 * the one capp gen creates:
 *
 *     Frameworks/<Name>          from Build/Release/<Name>
 *     Frameworks/Debug/<Name>    from Build/Debug/<Name>
 *
 * Copies, not links.  The applications are meant to be opened directly in
 * Safari over file://, with no server.  Safari reliably reads only files inside
 * the application's directory.  A link that leads out of it, into Build, fails
 * with "Cannot open file" once Safari has been restarted, and keeps failing
 * until a file at the link's target has been opened directly.  This applies to
 * the script tag that loads Objective-J.js and to every file the loader then
 * requests from the frameworks, so all of them are copied.
 *
 * APFS clones.  Each copy is made as an APFS clone where the volume supports
 * it: a separate file that shares its data with the build until either one
 * changes, so the copies take almost no disk space.  Other volumes get plain
 * copies.
 *
 * Consequences.  A copy does not follow a rebuild the way a link does, so run
 * configure again after every framework build.  Each application receives
 * thousands of files, so name the applications under test, by their path in
 * this directory:
 *
 *     npx jake configure CSVImportTest TableTest/DataView
 *
 * Without names, every application is configured.  clobber removes what
 * configure made, and leaves any other entry in Frameworks in place.
 */
task ("configure", function()
{
    var manualDir = __dirname;

    provisionFrameworks(
        requestedApplicationDirectories(manualDir, "configure"),
        path.resolve(manualDir, "../../Build/Release"),
        path.resolve(manualDir, "../../Build/Debug"),
        "build the frameworks in both configurations first"
    );
});

/*
 * Gives manual test applications the same Frameworks layout as configure, copied
 * from the capp-build package in Build/modern/Frameworks instead of the legacy
 * builds.  capp-build produces a single build, so Frameworks/Debug uses the same
 * package.  Applications are named as for configure.
 */
task ("configure-modern", function()
{
    var manualDir = __dirname,
        modernPath = path.resolve(manualDir, "../../Build/modern/Frameworks");

    provisionFrameworks(
        requestedApplicationDirectories(manualDir, "configure-modern"),
        modernPath,
        modernPath,
        "build the package with capp-build first (capp-build build . at the repository root)"
    );
});

/*
 * Fills Frameworks from releasePath and Frameworks/Debug from debugPath in each
 * application in appDirs, after checking that both hold every framework.  The
 * entries configure made before are replaced, and any other entry in Frameworks
 * is left in place.
 */
function provisionFrameworks(appDirs, releasePath, debugPath, missingHint)
{
    [releasePath, debugPath].forEach(function(buildPath)
    {
        ConfiguredFrameworks.forEach(function(framework)
        {
            if (!fs.existsSync(path.join(buildPath, framework)))
                throw new Error(path.join(buildPath, framework) + " not found; " + missingHint);
        });
    });

    appDirs.forEach(function(appDir)
    {
        var frameworksPath = path.join(appDir, "Frameworks");

        console.log("Configuring " + path.basename(appDir));

        removeConfiguredFrameworks(appDir);
        fillFrameworksDirectory(frameworksPath, releasePath);
        fillFrameworksDirectory(path.join(frameworksPath, "Debug"), debugPath);
    });
}

/*
 * Copies each configured framework from buildPath into aDirectory, as an APFS
 * clone where the volume supports it.
 */
function fillFrameworksDirectory(aDirectory, buildPath)
{
    fs.mkdirSync(aDirectory, { recursive: true });

    ConfiguredFrameworks.forEach(function(framework)
    {
        fs.cpSync(path.join(buildPath, framework), path.join(aDirectory, framework), { recursive: true, mode: fs.constants.COPYFILE_FICLONE });
    });
}

/*
 * Cleans the subsidiary applications' Build directories exclusively (-mindepth 2 -maxdepth 2).
 */
task ("clean", function()
{
    var manualDir = __dirname;
    var targetName = path.basename(ENV["BUILD_PATH"] || ENV["CAPP_BUILD"] || "Build");
    cp.execSync("find . -mindepth 2 -maxdepth 2 -type d -name '" + targetName + "' -exec rm -rf {} +", { stdio: "inherit", cwd: manualDir });
});

/*
 * Removes the Frameworks entries configure made from every manual test
 * application, after delegating Build directory removal to clean.  Any other
 * entry in Frameworks is left in place.
 */
task ("clobber", ["clean"], function()
{
    var manualDir = __dirname;

    manualApplicationDirectories(manualDir).forEach(removeConfiguredFrameworks);
});

/*
 * Returns the absolute paths of the manual test applications named on the
 * command line after taskName, or of every application when none is named.  A
 * name is the application's path in this directory; a trailing slash is
 * allowed.  Jake runs each word on the command line as a task, so each name is
 * also declared as an empty task, which Jake then runs without effect.  Words of
 * the form NAME=value are Jake's environment settings, not names.
 */
function requestedApplicationDirectories(manualDir, taskName)
{
    var allDirectories = manualApplicationDirectories(manualDir),
        taskIndex = process.argv.indexOf(taskName),
        names = taskIndex < 0 ? [] : process.argv.slice(taskIndex + 1).filter(function(word)
        {
            return !/^\w+=/.test(word);
        });

    if (names.length === 0)
        return allDirectories;

    return names.map(function(name)
    {
        var appDir = path.resolve(manualDir, name.replace(/\/+$/, ""));

        if (JAKE.application().lookup(name))
            throw new Error(name + " is a task in this Jakefile, not an application");

        if (allDirectories.indexOf(appDir) < 0)
            throw new Error(name + " is not a manual test application in " + manualDir);

        JAKE.task(name);

        return appDir;
    });
}

/*
 * Returns the absolute paths of the manual test applications: every directory
 * below this one that contains a Jakefile.
 */
function manualApplicationDirectories(manualDir)
{
    /*
        Frameworks holds copies of the frameworks, and Build holds build products,
        so neither is searched.
    */
    var jakefiles = cp.execSync("find . -mindepth 2 \\( -name Frameworks -o -name Build \\) -prune -o -iname 'jakefile' -print", { cwd: manualDir, encoding: "utf8" });

    return jakefiles.split("\n").filter(Boolean).map(function(jakefile)
    {
        return path.resolve(manualDir, path.dirname(jakefile));
    });
}

/*
 * Removes what configure made in an application's Frameworks: a Frameworks
 * link, or the entries named after the configured frameworks and Debug, whether
 * they are links or directories.  Any other entry is left in place, and so is a
 * directory that still holds one.  Links are removed, never followed.
 */
function removeConfiguredFrameworks(appDir)
{
    var frameworksPath = path.join(appDir, "Frameworks"),
        stat = fs.lstatSync(frameworksPath, { throwIfNoEntry: false });

    if (stat && stat.isSymbolicLink())
    {
        fs.unlinkSync(frameworksPath);
        return;
    }

    if (!stat || !stat.isDirectory())
        return;

    removeConfiguredEntries(path.join(frameworksPath, "Debug"));
    removeConfiguredEntries(frameworksPath);
}

/*
 * Removes aPath when it is a link.  When it is a directory, removes its entries
 * named after the configured frameworks, then removes the directory if it is
 * empty.
 */
function removeConfiguredEntries(aPath)
{
    var stat = fs.lstatSync(aPath, { throwIfNoEntry: false });

    if (!stat)
        return;

    if (stat.isSymbolicLink())
    {
        fs.unlinkSync(aPath);
        return;
    }

    if (!stat.isDirectory())
        return;

    ConfiguredFrameworks.forEach(function(framework)
    {
        var entry = path.join(aPath, framework),
            entryStat = fs.lstatSync(entry, { throwIfNoEntry: false });

        if (entryStat && entryStat.isSymbolicLink())
            fs.unlinkSync(entry);
        else if (entryStat)
            fs.rmSync(entry, { recursive: true });
    });

    if (fs.readdirSync(aPath).length === 0)
        fs.rmdirSync(aPath);
}

/*
 * -----------------------------------------------------------------------------
 * Manual Execution Targets
 * -----------------------------------------------------------------------------
 */

/*
 * Triggers baseline compilation across all subproject manual tests for local testing.
 */
task ("batch-compile", function()
{
    var manualDir = __dirname;
    cp.execSync("find . -mindepth 2 -iname 'jakefile' -execdir npx jake build \\;", { stdio: "inherit", env: ENV, cwd: manualDir });
});

task ("batch-compile-all", ["batch-compile-debug", "batch-compile-release"]);

task ("batch-compile-debug", function()
{
    var manualDir = __dirname;
    ENV["CONFIGURATION"] = "Debug";
    cp.execSync("find . -mindepth 2 -iname 'jakefile' -execdir npx jake debug \\;", { stdio: "inherit", env: ENV, cwd: manualDir });
});

task ("batch-compile-release", function()
{
    var manualDir = __dirname;
    ENV["CONFIGURATION"] = "Release";
    cp.execSync("find . -mindepth 2 -iname 'jakefile' -execdir npx jake release \\;", { stdio: "inherit", env: ENV, cwd: manualDir });
});
